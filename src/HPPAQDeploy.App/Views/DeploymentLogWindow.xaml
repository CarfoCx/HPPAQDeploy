<Window x:Class="HPPAQDeploy.App.Views.DeploymentLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:HPPAQDeploy.App.Converters"
        Title="Fleet Deployment Monitor"
        Icon="../Resources/app_icon.png"
        Width="1050" Height="650"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Topmost="{Binding AlwaysOnTop, Mode=TwoWay}"
        Background="{StaticResource ContentBgBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColor" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVis" />
        <converters:NonZeroToVisibilityConverter x:Key="NonZeroToVis" />
        <converters:BoolToTextWrappingConverter x:Key="BoolToTextWrapping" />
        <converters:StringContainsToVisibilityConverter x:Key="WaitingToVis" SearchText="Waiting for HPIA" />
        <converters:StringContainsToVisibilityConverter x:Key="NotWaitingToVis" SearchText="Waiting for HPIA" Invert="True" />
    </Window.Resources>

    <Grid>
        <TabControl ItemsSource="{Binding ActiveSessions}" SelectedItem="{Binding SelectedSession}"
                    Style="{StaticResource MaterialDesignTabControl}"
                    Background="Transparent" BorderThickness="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="MonitorMultiple" Width="14" Height="14" 
                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                 Foreground="{StaticResource HpBlueBrush}" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="MonitorMultiple" Width="20" Height="20"
                                                         Foreground="{StaticResource HpBlueBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding DataContext.AutoScroll, RelativeSource={RelativeSource AncestorType=Window}}"
                                               ToolTip="Auto-scroll to newest entries"
                                               Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                               Height="28" Width="28" Padding="0" Margin="0,0,4,0">
                                    <materialDesign:PackIcon Kind="ArrowDownBold" Width="16" Height="16" />
                                </ToggleButton>

                                <ToggleButton IsChecked="{Binding DataContext.WordWrap, RelativeSource={RelativeSource AncestorType=Window}}"
                                               ToolTip="Toggle word wrap"
                                               Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                               Height="28" Width="28" Padding="0" Margin="0,0,4,0">
                                    <materialDesign:PackIcon Kind="Wrap" Width="16" Height="16" />
                                </ToggleButton>

                                <Border Width="1" Height="20" Background="{StaticResource DividerBrush}"
                                        Margin="0,0,8,0" VerticalAlignment="Center" />

                                <Button Content="Clear" Command="{Binding ClearLogsCommand}"
                                        ToolTip="Clear all log entries"
                                        Style="{StaticResource DangerButton}"
                                        Height="26" FontSize="12" Padding="10,2" MinWidth="0" Margin="0,0,4,0" />

                                <Button Command="{Binding DataContext.ExportResultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Export deployment log to CSV file"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="26" FontSize="12" Padding="10,2" MinWidth="0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExport" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="Export CSV" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Row 1: Filter bar + progress -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4"
                                          Foreground="{StaticResource AccentGreenBrush}"
                                          Background="{StaticResource ProgressBarTrackBrush}"
                                          Visibility="{Binding IsDeploying, Converter={StaticResource BoolToVis}}"
                                          Margin="0,0,0,6" />

                            <Border Background="{StaticResource SubtleBackgroundBrush}"
                                    CornerRadius="4" Padding="8,4">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="300" />

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding LogFilterText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                 materialDesign:HintAssist.Hint="Filter by device or message..."
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 MinWidth="280" Height="28" FontSize="12"
                                                 Padding="6,4" Margin="0,0,12,0"
                                                 VerticalContentAlignment="Center" />
                                        <TextBlock Text="Level:" Style="{StaticResource SubtitleText}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{Binding DataContext.LogLevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding LogLevelFilter}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  MinWidth="90" Height="28" FontSize="12" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Style="{StaticResource MaterialDesignTabControl}">
                            <!-- TAB 1: Live Status Board -->
                            <TabItem Header="Live Fleet Status Board" FontSize="14" FontWeight="SemiBold">
                                <Border Style="{StaticResource AppCard}" Padding="4" Margin="0,8,0,0">
                                    <Grid>
                                        <!-- Devices DataGrid -->
                                        <DataGrid ItemsSource="{Binding Devices}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                                                  VerticalGridLinesBrush="Transparent"
                                                  RowHeaderWidth="0"
                                                  SelectionMode="Single"
                                                  Style="{StaticResource ProfessionalDataGrid}"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="1.5*" FontWeight="SemiBold" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                                                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="1.2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                                                <DataGridTextColumn Header="OS Version" Binding="{Binding OsVersion}" Width="1.8*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                                                <DataGridTextColumn Header="BIOS" Binding="{Binding BiosVersion}" Width="1*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                                                <DataGridTemplateColumn Header="Reboot" Width="0.8*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="3" Padding="4,2" HorizontalAlignment="Left"
                                                                    Background="{StaticResource TagBackgroundBrush}"
                                                                    Visibility="{Binding NeedsReboot, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="RestartAlert" Width="12" Height="12" Foreground="#FFA726" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="Yes" FontSize="10" FontWeight="SemiBold" Foreground="#FFA726" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Status" Width="1.2*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <ProgressBar 
                                                                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                                    Value="{Binding Progress}" 
                                                                    Width="14" Height="14" Margin="0,0,6,0"
                                                                    Foreground="{StaticResource HpBlueBrush}"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                                    <ProgressBar.RenderTransform>
                                                                        <RotateTransform x:Name="Rotation" Angle="0" />
                                                                    </ProgressBar.RenderTransform>
                                                                    <ProgressBar.Resources>
                                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Setter Property="IsIndeterminate" Value="False" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Scanning">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Setter Property="IsIndeterminate" Value="True" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Analyzing">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Setter Property="IsIndeterminate" Value="True" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Deploying">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Setter Property="IsIndeterminate" Value="False" />
                                                                                </DataTrigger>
                                                                                <Trigger Property="Visibility" Value="Visible">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard x:Name="SpinStoryboard">
                                                                                            <Storyboard>
                                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                                 From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever" />
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ProgressBar.Resources>
                                                                </ProgressBar>
                                                                <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left"
                                                                        Background="{StaticResource DividerBrush}">
                                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Updates Found" Width="1*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                                <Run Text="{Binding Recommendations.Count, Mode=OneWay}" Foreground="{StaticResource HpBlueBrush}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </TabItem>

                            <!-- TAB 2: Console Logs -->
                            <TabItem Header="Technical Logs Console" FontSize="14" FontWeight="SemiBold">
                                <Border Style="{StaticResource AppCard}" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <!-- Log entries -->
                                        <ItemsControl ItemsSource="{Binding FilteredLogs}"
                                                      FontFamily="Consolas">
                                            <ItemsControl.Template>
                                                <ControlTemplate TargetType="ItemsControl">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ItemsControl.Template>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="2,4" Margin="0,1" Background="{StaticResource SubtleBackgroundBrush}" CornerRadius="3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="8" Height="8" Margin="4,0,8,0" Fill="{Binding Level, Converter={StaticResource StatusToColor}}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="White" Opacity="0.6" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding DeviceName}" FontWeight="Bold" Foreground="{StaticResource HpBlueBrush}" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>

                        <!-- Row 3: Status bar -->
                        <Border Grid.Row="3" Margin="0,4,0,0" Padding="4,2">
                            <TextBlock Style="{StaticResource CaptionText}">
                                <Run Text="Logs: " />
                                <Run Text="{Binding Logs.Count, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Border>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
